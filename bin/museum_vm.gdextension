[configuration]

entry_symbol = "museum_vm_init"
compatibility_minimum = "4.5"

[libraries]

windows.debug.x86_64 = "res://bin/museum_vm.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/museum_vm.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/museum_vm.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/museum_vm.linux.template_release.x86_64.so"
macos.debug = "res://bin/museum_vm.macos.template_debug.universal.dylib"
macos.release = "res://bin/museum_vm.macos.template_release.universal.dylib"
web.debug.threads.wasm32 = "res://bin/museum_vm.web.template_debug.wasm32.wasm"
web.release.threads.wasm32 = "res://bin/museum_vm.web.template_release.wasm32.wasm"
web.debug.wasm32 = "res://bin/museum_vm.web.template_debug.wasm32.nothreads.wasm"
web.release.wasm32 = "res://bin/museum_vm.web.template_release.wasm32.nothreads.wasm"
