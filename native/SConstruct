#!/usr/bin/env python
# Builds the museum_vm GDExtension. GODOT_CPP points at a godot-cpp checkout built against the
# engine's dumped extension_api.json (see docs/NATIVE_BUILD.md). Objects go to
# build/<platform>.<target>[.nothreads]/ so platforms can be built without clobbering each other.
import os

godot_cpp = os.environ.get("GODOT_CPP", "godot-cpp")
env = SConscript(os.path.join(godot_cpp, "SConstruct"))
platform = env["platform"]
suffix = env["suffix"]
variant = "build/{}{}".format(platform, suffix)
VariantDir(variant, "src", duplicate=0)
env.Append(CPPPATH=["src/"])
sources = Glob(variant + "/*.cpp") + [variant + "/thirdparty/opl3.c"]
if platform == "web":
    target = "../bin/museum_vm{}.wasm".format(suffix)
else:
    target = "../bin/museum_vm{}{}".format(suffix, env["SHLIBSUFFIX"])
library = env.SharedLibrary(target, source=sources)
Default(library)
